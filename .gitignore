# Rust
/target/
Cargo.lock
# Do not commit the vendored crates directory; we vendor at build-time in the
# Flatpak manifest instead. This keeps the git history small.
vendor/

# Environment variables (contains secrets)
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
macOS/

# Build artifacts
*.o
*.so
*.dylib

# Generated by Cargo
**/*.rs.bk

# Flatpak / flatpak-builder artifacts
# local build export repo created by flatpak-builder
/repo/
# builddir produced by flatpak-builder
/builddir/
# flatpak-builder runtime state and rofiles
/.flatpak-builder/

# App export and metadata produced by flatpak-builder
/metadata
/metadata.debuginfo
/export/
/files/
/screenshots/

# Flatpak bundles and local repos
*.flatpak
flatpak/*.flatpak
